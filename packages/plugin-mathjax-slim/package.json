{
  "name": "@mdit/plugin-mathjax-slim",
  "version": "1.2.3",
  "description": "mathjax plugin for MarkdownIt",
  "keywords": [
    "markdown-it",
    "markdown-it-plugin",
    "mathjax"
  ],
  "homepage": "https://mdit-plugins.github.io/mathjax.html",
  "bugs": {
    "url": "https://github.com/mdit-plugins/mdit-plugins/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Mr.Hope",
    "email": "mister-hope@outlook.com",
    "url": "https://mister-hope.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdit-plugins/mdit-plugins.git",
    "directory": "packages/plugin-mathjax-slim"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./async": {
      "types": "./dist/async/index.d.ts",
      "default": "./dist/async/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf ./dist"
  },
  "dependencies": {
    "@mdit/plugin-tex": "workspace:*",
    "synckit": "^0.12.3"
  },
  "devDependencies": {
    "@mathjax/mathjax-tex-font": "catalog:",
    "@mathjax/src": "catalog:"
  },
  "peerDependencies": {
    "@mathjax/mathjax-newcm-font": "catalog:",
    "@mathjax/src": "catalog:",
    "markdown-it": "catalog:"
  },
  "peerDependenciesMeta": {
    "@mathjax/mathjax-newcm-font": {
      "optional": true
    },
    "@mathjax/src": {
      "optional": true
    },
    "markdown-it": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
