{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":prHourlyLimitNone", ":prConcurrentLimitNone"],
  "dependencyDashboard": true,
  "schedule": ["every weekend"],
  "packageRules": [
    {
      "description": "Patch/minor devDependency updates are safe to merge automatically.",
      "automerge": true,
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"]
    },
    {
      "description": "Major devDependency updates need a human review.",
      "automerge": false,
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["major"]
    },
    {
      "description": "Deliberately pinned toolchain (TS 7 preview, tsdown, oxc); always review manually.",
      "automerge": false,
      "matchPackageNames": [
        "@mr-hope/tsconfig",
        "oxc-config-hope",
        "oxfmt",
        "oxlint",
        "oxlint-tsgolint",
        "tsdown",
        "typescript"
      ]
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "commitMessageAction": "update lockfile",
    "platformAutomerge": true,
    "extends": ["group:allNonMajor", "schedule:weekly"]
  },
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "minimumReleaseAge": "1 day",
  "timezone": "Asia/Shanghai"
}
