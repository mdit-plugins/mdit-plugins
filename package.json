{
  "name": "@mdit/root",
  "private": true,
  "description": "MarkdownIt plugin collections written in typescript",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_ENV=production pnpm run --stream -r build",
    "bundle:analyze": "node --experimental-strip-types scripts/analyze.ts",
    "clean": "pnpm run --stream -r clean",
    "docs:build": "pnpm run --filter=docs docs:build",
    "docs:dev": "pnpm run --filter=docs docs:dev",
    "lint": "oxlint --fix && oxfmt",
    "lint:check": "oxlint && oxfmt --check",
    "lint:md": "markdownlint-cli2 **/*.md",
    "packages:bootstrap": "node --experimental-strip-types scripts/bootstrap.ts",
    "packages:check-update": "pnpm dlx npm-check-updates",
    "packages:update": "pnpm up -r",
    "prepare": "husky",
    "test": "vitest run",
    "test:bench": "vitest bench",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@codecov/bundle-analyzer": "2.0.1",
    "@lerna-lite/cli": "5.6.2",
    "@lerna-lite/publish": "5.6.2",
    "@mr-hope/tsconfig": "0.0.4",
    "@mr-hope/verify-commit-message": "0.1.1",
    "@types/node": "24.19.0",
    "@vitest/coverage-istanbul": "5.0.2",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "cross-env": "10.1.0",
    "happy-dom": "20.14.5",
    "husky": "9.1.7",
    "markdownlint-cli2": "0.23.3",
    "nano-staged": "1.0.2",
    "npm-check-updates": "23.1.0",
    "oxc-config-hope": "0.3.15",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "picocolors": "1.1.1",
    "publint": "0.3.24",
    "rimraf": "6.1.3",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "unrun": "0.3.1",
    "vitest": "5.0.2"
  },
  "nano-staged": {
    "**/*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,ts}": "oxlint --fix",
    "*.md": "markdownlint-cli2 --fix"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^22.23.0 || ^24.21.0 || ^26.10.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
