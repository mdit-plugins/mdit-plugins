{
  "name": "@mdit/root",
  "private": true,
  "description": "MarkdownIt plugin collections written in typescript",
  "type": "module",
  "scripts": {
    "bench:clean": "node --experimental-strip-types scripts/prepareBench.ts --clean",
    "bench:prepare": "node --experimental-strip-types scripts/prepareBench.ts",
    "build": "cross-env NODE_ENV=production pnpm run --stream -r build",
    "bundle:analyze": "node --experimental-strip-types scripts/analyze.ts",
    "clean": "pnpm run --stream -r clean",
    "compare": "node --experimental-strip-types compare/run.ts",
    "compare:bench": "node --experimental-strip-types compare/run.ts --bench-only",
    "compare:check": "node --experimental-strip-types compare/syncDocs.ts --check",
    "compare:docs": "node --experimental-strip-types compare/syncDocs.ts",
    "compare:sizes": "node --experimental-strip-types compare/size.ts",
    "compare:test": "node --experimental-strip-types compare/run.ts --correctness-only",
    "compare:tests": "node --experimental-strip-types compare/test-suite.ts",
    "docs:build": "pnpm run --filter=docs docs:build",
    "docs:dev": "pnpm run --filter=docs docs:dev",
    "lint": "oxlint --fix && oxfmt",
    "lint:check": "oxlint && oxfmt --check",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "packages:bootstrap": "node --experimental-strip-types scripts/bootstrap.ts",
    "packages:check-readme": "node --experimental-strip-types scripts/syncReadme.ts --check",
    "packages:check-update": "pnpm dlx npm-check-updates",
    "packages:sync-readme": "node --experimental-strip-types scripts/syncReadme.ts",
    "packages:update": "pnpm up -r",
    "prepare": "husky",
    "test": "vitest run",
    "test:bench": "pnpm run bench:prepare && vitest bench",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@codecov/bundle-analyzer": "2.0.1",
    "@lerna-lite/cli": "5.6.4",
    "@lerna-lite/publish": "5.6.4",
    "@mr-hope/tsconfig": "0.0.4",
    "@mr-hope/verify-commit-message": "0.1.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-istanbul": "5.0.5",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "cross-env": "10.1.0",
    "happy-dom": "21.0.4",
    "husky": "9.1.7",
    "markdown-it": "catalog:",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-attrs": "^5.0.1",
    "markdown-it-cjk-breaks": "^2.0.1",
    "markdown-it-cjk-friendly": "^3.0.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-github-alerts": "^1.0.1",
    "markdown-it-image-figures": "^2.1.1",
    "markdown-it-imsize": "^2.0.1",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-katex": "^2.0.3",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-mathjax3": "^5.2.0",
    "markdown-it-plantuml": "^1.4.1",
    "markdown-it-ruby": "^1.1.2",
    "markdown-it-spoiler": "^1.1.1",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-checkbox": "^1.0.6",
    "markdownlint-cli2": "0.24.0",
    "nano-staged": "1.0.2",
    "npm-check-updates": "23.1.1",
    "oxc-config-hope": "0.3.15",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "picocolors": "1.1.1",
    "publint": "0.3.25",
    "rimraf": "6.1.3",
    "tsdown": "0.23.4",
    "typescript": "7.0.2",
    "unrun": "0.3.1",
    "vitest": "5.0.5"
  },
  "nano-staged": {
    "**/*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,ts}": "oxlint --fix",
    "*.md": "markdownlint-cli2 --fix"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^22.23.4 || ^24.22.1 || ^26.13.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
